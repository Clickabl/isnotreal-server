+name: Domain runtime channel patch
+on:
+  push:
+    branches: [diagnostics/domain-runtime-channel]
+permissions:
+  contents: write
+jobs:
+  patch:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-node@v6
+        with:
+          node-version-file: .nvmrc
+          cache: npm
+      - run: npm ci
+      - name: Add domain subtree channel
+        run: |
+          python3 - <<'PY'
+          from pathlib import Path
+          p = Path('packages/persistence/src/runtime.ts')
