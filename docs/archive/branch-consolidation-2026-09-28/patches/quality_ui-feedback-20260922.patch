+    for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);
+    return node;
+  };
+  const announce = (text, bad = false) => { status.textContent = text; status.setAttribute('role', bad ? 'alert' : 'status'); };
+  const action = (text, fn) => {
