diff --git a/.github/workflows/quality-feedback.yml b/.github/workflows/quality-feedback.yml
new file mode 100644
index 0000000..c722965
--- /dev/null
+++ b/.github/workflows/quality-feedback.yml
@@ -0,0 +1,63 @@
+name: Verify complete feedback and UI workflow
+on:
+  push:
+    branches: [quality/ui-feedback-20260922]
+permissions:
+  contents: write
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    env:
+      DATABASE_URL: postgres://postgres:postgres@127.0.0.1:5432/isnotreal_test
+      RUN_DB_INTEGRATION: '1'
+    services:
+      postgres:
+        image: postgres:17-alpine
+        env:
+          POSTGRES_USER: postgres
+          POSTGRES_PASSWORD: postgres
+          POSTGRES_DB: isnotreal_test
+        ports: ['5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U postgres -d isnotreal_test"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-node@v6
+        with:
+          node-version-file: .nvmrc
+          cache: npm
+      - name: Apply checksum-verified local changeset
+        shell: bash
+        run: |
+          set -euo pipefail
+          cat .github/quality-part-1 .github/quality-part-2 .github/quality-part-3 > "$RUNNER_TEMP/quality.tar.xz"
