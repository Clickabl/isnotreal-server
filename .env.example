PUBLIC_ORIGIN=https://isnotreal.click
API_BASE_URL=https://isnotreal.click/api/v1
ENTITY_BASE_URL=https://isnotreal.click
ALTERNATIVE_REDIRECT_BASE_URL=https://isnotreal.click/go-to-alt

DATABASE_URL=postgres://user:password@localhost:5432/isnotreal
HOST=0.0.0.0
PORT=3000
DB_POOL_MAX=20
PUBLICATION_ROOT=.local/publications
PUBLICATION_TTL_HOURS=48
COMPILER_VERSION=dev
SOURCE_REVISION=local
# MIGRATIONS_DIR=db/migrations

# Optional authenticated moderation/admin surface. Generate a random secret; never expose to clients.
# ADMIN_BEARER_TOKEN=
# ADMIN_ACTOR_ID=tim

# Admin uses a separate editor-role database connection; public runtime credentials stay least-privilege.
# ADMIN_DATABASE_URL=

# Store links are shown only when they point at the official expected host.
# CHROME_WEB_STORE_URL=
# FIREFOX_ADDON_URL=
# SAFARI_APP_STORE_URL=

# Publisher process only. Keep the private key out of the public API process and repository.
# PUBLICATION_SIGNING_KEY_FILE=/etc/isnotreal/publication-ed25519.pem
# PUBLICATION_SIGNING_KEY_ID=release-1
