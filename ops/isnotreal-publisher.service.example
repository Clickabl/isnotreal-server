[Unit]
Description=isnotreal.click signed publication compiler
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=isnotreal-publisher
Group=isnotreal-publisher
WorkingDirectory=/srv/isnotreal-server
EnvironmentFile=/etc/isnotreal/publisher.env
ExecStart=/usr/bin/env npm run publish:local
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/isnotreal-server/.local/publications
