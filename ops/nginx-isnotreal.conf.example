# Define this in nginx.conf's http {} block, not inside server {}.
# The edge limit is the primary per-client abuse control. Application-level
# submission limiting remains a backstop and must not trust spoofable forwarding headers.
limit_req_zone $binary_remote_addr zone=isnotreal_public:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=isnotreal_write:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=isnotreal_conn:10m;

server {
    listen 80;
    server_name isnotreal.click www.isnotreal.click;
    return 301 https://isnotreal.click$request_uri;
}

server {
    listen 443 ssl http2;
    server_name isnotreal.click;
    ssl_certificate /etc/letsencrypt/live/isnotreal.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/isnotreal.click/privkey.pem;

    client_max_body_size 128k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 10s;
    send_timeout 15s;
    limit_conn isnotreal_conn 20;
    limit_req_status 429;

    # Immutable signed datasets are cache-friendly and should be served by a CDN
    # in production. Nginx still applies a generous client limit as a backstop.
    location ^~ /data/publications/ {
        limit_req zone=isnotreal_public burst=80 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # Public write path gets its own much smaller budget.
    location = /api/v1/submissions {
        limit_req zone=isnotreal_write burst=3 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # Admin console contains no secret by itself, but keep the editor surface on
    # the same restricted operator network as the authenticated admin API.
    location = /admin-console {
        limit_req zone=isnotreal_write burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # Admin endpoints should additionally be network restricted at deployment
    # (VPN/private network/firewall). Bearer auth in the app is not the only layer.
    location ^~ /admin/ {
        limit_req zone=isnotreal_write burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # Canonical numeric entity links and alternative redirects are resolved by
    # PostgreSQL-backed application routes, so there is no stale generated map.
    location / {
        limit_req zone=isnotreal_public burst=40 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
