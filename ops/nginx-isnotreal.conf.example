server {
    listen 80;
    server_name isnotreal.click www.isnotreal.click;
    return 301 https://isnotreal.click$request_uri;
}

server {
    listen 443 ssl http2;
    server_name isnotreal.click;
    ssl_certificate /etc/letsencrypt/live/isnotreal.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/isnotreal.click/privkey.pem;
    client_max_body_size 1m;
    # Canonical numeric entity links are handled by the application so redirects
    # always reflect the database's current slug. No giant rewrite map is needed.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
