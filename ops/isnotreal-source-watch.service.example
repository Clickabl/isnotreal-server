[Unit]
Description=isnotreal.click official source change watcher
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=isnotreal-editor
Group=isnotreal-editor
WorkingDirectory=/srv/isnotreal-server
EnvironmentFile=/etc/isnotreal/source-watch.env
ExecStart=/usr/bin/env npm run sources:watch
SuccessExitStatus=0 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/isnotreal-server/.local/publications
