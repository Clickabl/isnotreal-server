{
  "name": "isnotreal-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:migrate": "npm run build && node apps/api/dist/migrate.js",
    "publish:local": "npm run build && node apps/api/dist/publish.js",
    "reason-catalog:publish": "npm run build && node apps/api/dist/publish-reason-catalog.js",
    "start": "node apps/api/dist/serve.js",
    "start:local": "npm run build && npm run start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
